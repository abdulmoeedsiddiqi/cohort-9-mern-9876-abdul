NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgresql://notes_app:notes_app@localhost:5433/notes_app?schema=public
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=auth_token
# Any OpenAI-compatible chat completions API works here (xAI/Grok, OpenAI,
# Groq, Gemini, ...) — just swap all three values for your provider of choice.
# Required for the "Summarize" feature only; get a Grok key at https://console.x.ai.
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4-fast-non-reasoning
