NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgresql://notes_app:notes_app@localhost:5433/notes_app?schema=public
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=auth_token
# Any OpenAI-compatible chat completions API works here (OpenAI, Groq,
# Gemini, ...) — just swap all three values for your provider of choice.
# Required for the "Summarize" feature only; get a key at https://platform.openai.com.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
